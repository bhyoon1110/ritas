# RIST Edge 서버 비밀/환경 값 (git 추적 대상 아님)
#
# 이 파일은 deploy/install.sh 가 프로젝트 루트의 edge.env 로 복사한다(이미 있으면 보존).
#   경로: /home/rist/ritas/edge.env  (.gitignore 에 등록되어 git 추적 안 됨)
# 실제 운영 값으로 edge.env 를 직접 수정한 뒤 서비스를 재시작한다.
# 서비스 파일(rist-edge-*.service)에는 비밀값을 넣지 않으므로 git pull 충돌이 없다.
#
# 적용:
#   sudo systemctl restart rist-edge-api.service rist-edge-worker.service

# --- Edge API 공개 주소/저장소 override ---
# production 프로파일 기본값과 실제 서버 주소가 다를 때만 지정한다.
# RIST_EDGE_PUBLIC_BASE_URL=http://192.168.0.10:8000
RIST_STORAGE_ROOT=/home/rist/ritas/edge_api_server/data/jobs

# --- 운영 관리 기록 ---
# 사용 기록은 /operations의 "사용 기록" 탭에서 조회한다.
RIST_USAGE_LOG_ROOT=/home/rist/ritas/edge_api_server/data/jobs/usage
RIST_USAGE_LOG_RETENTION_DAYS=90
# 오류 로그, 스택 트레이스, 실패 당시 업로드 파일은 "오류 기록" 탭에서 조회한다.
RIST_ERROR_ARCHIVE_ROOT=/home/rist/ritas/edge_api_server/data/jobs/errors
RIST_ERROR_RETENTION_DAYS=30
RIST_ERROR_CAPTURE_FILES=true
# 오류 한 건에서 보관할 개별 파일/전체 파일의 최대 크기
RIST_ERROR_MAX_FILE_BYTES=536870912
RIST_ERROR_MAX_TOTAL_BYTES=2147483648

# --- MariaDB 접속 정보 ---
RIST_DB_HOST=127.0.0.1
RIST_DB_PORT=3306
RIST_DB_NAME=rist_edge
RIST_DB_USER=rist
RIST_DB_PASSWORD=change-me

# --- 공유 저장소 / DB 보고서 전송 큐 ---
# Spring Boot에도 같은 storage key에 대응하는 공유 저장소 마운트를 설정한다.
RIST_REPORT_STORAGE_KEY=RIST_REPORTS
RIST_REPORT_TRANSFER_MAX_ATTEMPTS=5
# 전송하지 않은 테스트 보고서, 실패/취소 보고서, LIMS 완료 보고서의 기본 보존 기간
RIST_REPORT_TEST_RETENTION_DAYS=7
RIST_REPORT_FAILED_RETENTION_DAYS=30
RIST_REPORT_COMPLETED_RETENTION_DAYS=90
# 휴지통 이동 후 실제 파일을 제거하기까지의 유예 기간
RIST_REPORT_TRASH_RETENTION_DAYS=7

# --- 웹 회원/프로젝트 권한/사내 SSO ---
# true이면 FTIR, Raman, XRD, TEM 및 운영 관리 화면에 로그인이 필요하다.
RIST_AUTH_ENABLED=true
# 로컬 로그인 유지 시간과 보고서 전송 직전에 인정할 SSO 최근 인증 시간
RIST_AUTH_SESSION_HOURS=12
RIST_AUTH_RECENT_SSO_MINUTES=30
# 현재처럼 http://bhyoon.me:8000 으로 운영하는 동안에는 false여야 쿠키가 전송된다.
# HTTPS 적용 후에는 반드시 true로 변경한다.
RIST_AUTH_COOKIE_SECURE=false
# 지정하면 해당 로그인 ID만 최초 관리자로 자동 활성화한다.
# 비워둔 초기 설치에서는 첫 가입자 한 명이 최초 관리자가 된다.
RIST_AUTH_BOOTSTRAP_ADMIN_IDS=admin
# 사내 SSO가 OIDC를 제공할 때 발급받은 값을 입력한다. 비밀값은 이 edge.env에만 둔다.
RIST_SSO_PROVIDER_NAME=RIST SSO
RIST_SSO_ISSUER_URL=
RIST_SSO_CLIENT_ID=
RIST_SSO_CLIENT_SECRET=
RIST_SSO_SCOPES=openid profile email

# --- 로컬 LLM ---
RIST_LLM_BASE_URL=http://127.0.0.1:8001
RIST_LLM_MODEL=gemma4-e4b
RIST_LLM_TIMEOUT_SECONDS=180
RIST_LLM_TEMPERATURE=0.1
RIST_LLM_MAX_TOKENS=1200
RIST_LLM_CONTEXT_WINDOW=8192
RIST_LLM_CONTEXT_MARGIN=256
RIST_LLM_VALIDATE_MODEL=true
RIST_LLM_INCLUDE_IMAGES=true
RIST_LLM_MAX_IMAGES=3
RIST_LLM_MAX_IMAGE_BYTES=2097152
RIST_LLM_MAX_INPUT_CHARS=200000

# --- TEM/STEM 보고서 생성 ---
# 보고서 작업은 PPT/OCR 메모리 사용량이 커서 기본 1개씩 순차 처리한다.
RIST_TEM_REPORT_WORKERS=1
# 코팅층 두께 OCR 병렬 처리 수. 서버 CPU 여유가 있으면 3~4까지 올릴 수 있다.
RIST_TEM_OCR_WORKERS=2

# --- XRD PDF 서버 렌더링 ---
# /xrd 보고서의 PDF Export는 서버의 Chrome/Chromium headless 렌더러를 우선 사용한다.
# 자동 탐색 후보에 없거나 systemd PATH에서 찾지 못하면 실제 경로를 지정한다.
# 예: Ubuntu snap chromium
# RIST_PDF_CHROME_BIN=/snap/bin/chromium
# 예: 일반 패키지 chromium
# RIST_PDF_CHROME_BIN=/usr/bin/chromium
# snap Chromium이 /tmp 접근 문제로 PDF 파일을 만들지 못하면 home 하위 경로를 명시한다.
# 기본값: /home/rist/ritas/edge_api_server/data/pdf_renders
# RIST_XRD_PDF_RENDER_DIR=/home/rist/ritas/edge_api_server/data/pdf_renders

# --- 필요 시 로깅/기타 재정의 ---
# RIST_LOG_LEVEL=INFO
# RIST_LOG_FORMAT=text

# --- FT-IR 피크 assignment 라이브러리 ---
# 기본값: /home/rist/ritas/edge_api_server/data/ftir_assignment_libraries
# RIST_FTIR_ASSIGNMENT_LIBRARY_DIR=/data/rist/ftir_assignment_libraries
# 기본값: false. true로 바꾸면 /ftir 화면과 API에서 라이브러리 파일 삭제 허용
# RIST_FTIR_ASSIGNMENT_LIBRARY_DELETE_ENABLED=false
